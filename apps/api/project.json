{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "tsdown -c apps/api/tsdown.config.mts",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "tsdown -c apps/api/tsdown.config.mts --watch --no-clean",
          "node --watch dist/apps/api/main.cjs"
        ],
        "env": {
          "NODE_ENV": "development"
        }
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        },
        "production": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "tsc --noEmit -p apps/api/tsconfig.app.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "lint": {}
  }
}
